# No service key is needed for Verify. Copy this file to .env; keep it private.
HOST=127.0.0.1
PORT=5173
VERUS_RPC_URL=https://api.verustest.net

# Sign requires an existing VRSCTEST service identity and its authorized WIF.
# Never use VITE_ prefixed variables for secrets.
VATERMARK_SERVICE_ID=
VATERMARK_SERVICE_WIF=

# Redirect opens the phone's browser with the signed response; local HTTP works.
WALLET_RESPONSE_MODE=redirect
# Default in redirect mode: http://127.0.0.1:5173 (or the configured PORT).
# For a physical phone, set HOST=0.0.0.0 and use this computer's LAN address,
# e.g. PUBLIC_ORIGIN=http://192.168.1.42:5173. Both devices must reach that address.
# Optional WALLET_RESPONSE_MODE=post retains the HTTPS-only binary POST callback.
PUBLIC_ORIGIN=
# Optional direct local HTTPS. Keep certificates out of source control.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Defaults: private .data directory, 96 MiB uploads, 24 MP images, 2 Rust workers.
# DATA_DIR=.data
# WORKER_CONCURRENCY=2
# MAX_UPLOAD_BYTES=100663296
# SIGN_JOB_TTL_MINUTES=15
# OUTPUT_TTL_MINUTES=60

# Optional hosted configuration (see FIREBASE_DEPLOYMENT.md).
# Keep the local defaults above unless deliberately running against cloud storage.
# Cloud Run receives the service ID/WIF through Secret Manager, never this file.
# HOST=0.0.0.0
# PORT=8080
# PUBLIC_ORIGIN=https://YOUR_PROJECT_ID.web.app
# JOB_STORAGE_BUCKET=YOUR_PROJECT_ID-private-jobs
# DATA_DIR=/tmp/vatermark
# WORKER_CONCURRENCY=1
# MAX_UPLOAD_BYTES=31457280

# Pre-created test identity gift cards (see GIFT_CARDS.md). Disabled by default.
# GIFTS_ENABLED=true
# GIFTS_STATE_FILE=.data/gifts/state.json
# Claims have no network cooldowns or rate quotas. Assigned cards stay private to the browser session.
