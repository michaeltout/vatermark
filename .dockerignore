# Deny by default: only these source inputs may reach Cloud Build or Docker.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!vite.config.ts
!vitest.config.ts
!playwright.config.ts
!index.html
!src/
!src/**
!server/
!server/**
!scripts/
!scripts/gift-referrals.ts
!scripts/gift-registration.ts
!scripts/gift-commitment.ts
!scripts/generate-gifts.ts
!scripts/import-gifts.ts
!tests/
!tests/**
!engine/
!engine/Cargo.toml
!engine/Cargo.lock
!engine/src/
!engine/src/**
!engine/tests/
!engine/tests/fixtures/
!engine/tests/fixtures/mobile-profile.json

# These exclusions win even if accidentally placed under a source directory.
**/.env
**/.env.*
**/.git
**/.git/**
**/.data
**/.data/**
**/node_modules
**/node_modules/**
**/target
**/target/**
**/certs
**/certs/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/.DS_Store
